@model SistemaPaquetesCondominio.Models.Residente

@{
    ViewBag.Title = "Registrar residente";
}

<h2>Registrar residente</h2>

@using (Html.BeginForm("Crear", "Residente", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.Nombre, "Nombre completo")
        @Html.TextBoxFor(m => m.Nombre,
            new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.Nombre)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Telefono, "Teléfono")
        @Html.TextBoxFor(m => m.Telefono,
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.Correo, "Correo electrónico")
        @Html.TextBoxFor(m => m.Correo,
            new { @class = "form-control", type = "email" })
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.ViviendaId, "Vivienda")
        @Html.DropDownListFor(
            m => m.ViviendaId,
            (IEnumerable<SelectListItem>)ViewBag.Viviendas,
            "Selecciona una vivienda",
            new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.ViviendaId)
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Guardar residente
    </button>

    @Html.ActionLink("Volver a la lista", "Index", null,
        new { @class = "btn btn-default" })
}