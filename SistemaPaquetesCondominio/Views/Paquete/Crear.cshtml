@model SistemaPaquetesCondominio.Models.Paquete

@{
    ViewBag.Title = "Registrar paquete";
}

<h2>Registrar paquete</h2>

@using (Html.BeginForm("Crear", "Paquete", FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.Descripcion, "Descripción del paquete")
        @Html.TextBoxFor(m => m.Descripcion,
            new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.Descripcion)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.ResidenteId, "Residente")
        @Html.DropDownListFor(
            m => m.ResidenteId,
            (IEnumerable<SelectListItem>)ViewBag.Residentes,
            "Selecciona un residente",
            new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.ResidenteId)
    </div>

    <div class="form-group">
        @Html.LabelFor(m => m.RegistradoPor, "Persona que recibe el paquete")
        @Html.TextBoxFor(m => m.RegistradoPor,
            new { @class = "form-control", required = "required" })
        @Html.ValidationMessageFor(m => m.RegistradoPor)
    </div>

    <br />

    <button type="submit" class="btn btn-primary">
        Guardar paquete
    </button>

    @Html.ActionLink("Volver a la lista", "Index", null,
        new { @class = "btn btn-default" })
}